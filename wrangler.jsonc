// Despliegue en Cloudflare (Workers con archivos estáticos).
{
  "name": "menu",
  "compatibility_date": "2026-11-10",
  // Mantiene activa la dirección menu.SUBDOMINIO.workers.dev en cada despliegue.
  "workers_dev": true,
  // Atiende /api/* (menús y cuentas); el resto son archivos del sitio.
  "main": "worker.js",
  // Base de datos de menús y cuentas. Cloudflare la crea sola en el primer
  // despliegue; las tablas las crea worker.js.
  "d1_databases": [{ "binding": "DB" }],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Las direcciones limpias (/atono) no son archivos: se atienden con index.html.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
